{
  "name": "thebookon",
  "version": "1.0.0",
  "private": true,
  "description": "The Book On Publishing site and author intake portal.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "admin:seed": "node scripts/seed-admin.mjs",
    "testdata:seed": "node scripts/seed-synthetic.mjs",
    "check": "node --check server.js",
    "test:mfa": "node --test tests/mfa.test.mjs",
    "test:notifications": "node --test notifications/core.node-tests.cjs notifications/events.node-tests.cjs",
    "notifications:status": "node notifications/status.cjs"
  },
  "dependencies": {
    "@compnd/cgsso-adapter": "file:vendor/cgss-adapter",
    "express": "^4.19.2",
    "multer": "2.5.0"
  },
  "overrides": {
    "qs": "6.16.1",
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.9"
  }
}
